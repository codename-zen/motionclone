{
	"name": "@codename-zen/motionclone",
	"version": "0.0.0",
	"description": "Measure web motion as numbers, rebuild it, and prove the rebuild moves the same way.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"motionclone": "dist/cli.js"
	},
	"files": [
		"dist",
		"skill"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"ffmpeg-static": "^5.3.0",
		"pixelmatch": "^8.0.0",
		"playwright": "^1.64.1",
		"pngjs": "^7.0.0",
		"ssim.js": "^3.5.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"@types/pngjs": "^6.0.5",
		"gsap": "^3.15.0",
		"motion": "^14.9.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
